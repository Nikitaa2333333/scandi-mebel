---
// Липкая шапка без фона — секции проезжают под ней.
// Телефон и иконки — из общих модулей, копий здесь не держим.
import Icon from './Icon.astro';
import { PHONE_HUMAN, PHONE_TEL, WHATSAPP_LINK, MAX_LINK } from '../lib/contacts';

const nav = [
  { href: '#configurator', label: 'Конфигуратор' },
  { href: '#models', label: 'Модели' },
  { href: '#steps', label: 'Как заказать' },
  { href: '#production', label: 'Производство' },
];
---

<header class="header">
  <div class="container header__row">
    <a href={import.meta.env.BASE_URL} class="header__logo">Scandi Мебель</a>
    <nav class="header__nav">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="header__contact">
      <a href={WHATSAPP_LINK} class="header__msg" target="_blank" rel="noopener" aria-label="Написать в WhatsApp">
        <Icon name="whatsapp" size={18} />
      </a>
      <a
        href={MAX_LINK || PHONE_TEL}
        class="header__msg"
        target={MAX_LINK ? '_blank' : undefined}
        rel={MAX_LINK ? 'noopener' : undefined}
        aria-label="Написать в MAX"
      >
        <Icon name="max" size={18} />
      </a>
      <a href={PHONE_TEL} class="header__phone">{PHONE_HUMAN}</a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: 16px;
  }
  .header__logo {
    font-weight: 500;
    font-size: var(--fs-body);
    white-space: nowrap;
  }
  .header__nav {
    display: flex;
    gap: clamp(16px, 2.5vw, 36px);
    font-size: var(--fs-small);
  }
  /* Телефон в шапке: она sticky, значит номер виден на любом экране */
  .header__contact {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .header__phone {
    font-size: var(--fs-small);
    font-weight: 450;
    white-space: nowrap;
  }
  .header__msg {
    display: inline-flex;
    color: var(--c-green);
  }
  .header__msg:hover { opacity: 0.7; }
  @media (max-width: 760px) {
    .header__nav { display: none; }
  }
  /* На узком экране номер цифрами не влезает рядом с логотипом —
     остаётся иконка WhatsApp, она и есть основной канал связи */
  @media (max-width: 480px) {
    .header__phone { display: none; }
  }
</style>
