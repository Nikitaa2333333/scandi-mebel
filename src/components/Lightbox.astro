---
// Просмотр фото в полный размер. Глобальный: цепляется к любой картинке
// с атрибутом data-zoom, группирует их по data-zoom-group — поэтому
// один и тот же компонент обслуживает и ткани, и каталог мебели.
// Ставится один раз в конце страницы.
---

<div class="lb" data-lb hidden>
  <button class="lb__close" type="button" data-lb-close aria-label="Закрыть">✕</button>
  <button class="lb__nav lb__nav--prev" type="button" data-lb-prev aria-label="Предыдущее фото">‹</button>
  <img class="lb__img" data-lb-img src="" alt="" />
  <p class="lb__counter small" data-lb-counter></p>
  <button class="lb__nav lb__nav--next" type="button" data-lb-next aria-label="Следующее фото">›</button>
</div>

<style>
  .lb {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    background: rgba(17 19 17 / 0.94);
    padding: clamp(12px, 4vw, 48px);
  }
  .lb[hidden] { display: none; }

  .lb__img {
    max-width: 100%;
    max-height: 88vh;
    object-fit: contain;
    /* Курсор-подсказка: клик по самой картинке не закрывает окно */
    cursor: default;
  }

  .lb__close,
  .lb__nav {
    position: absolute;
    background: none;
    border: 0;
    color: #fff;
    cursor: pointer;
    line-height: 1;
    padding: 12px;
  }
  .lb__close {
    top: clamp(8px, 2vw, 20px);
    right: clamp(8px, 2vw, 20px);
    font-size: 26px;
  }
  .lb__nav {
    top: 50%;
    translate: 0 -50%;
    font-size: 48px;
  }
  .lb__nav--prev { left: clamp(2px, 1.5vw, 20px); }
  .lb__nav--next { right: clamp(2px, 1.5vw, 20px); }
  .lb__close:hover, .lb__nav:hover { opacity: 0.7; }

  .lb__counter {
    position: absolute;
    bottom: clamp(10px, 2vw, 22px);
    color: #fff;
    margin: 0;
  }

  /* Одиночному кадру стрелки и счётчик не нужны */
  .lb.is-single .lb__nav,
  .lb.is-single .lb__counter { display: none; }

  /* Картинки, которые можно открыть, показывают это курсором */
  :global([data-zoom]) { cursor: zoom-in; }
</style>

<script>
  const box = document.querySelector<HTMLElement>('[data-lb]');
  if (box) {
    const img = box.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const counter = box.querySelector<HTMLElement>('[data-lb-counter]')!;
    let group: HTMLImageElement[] = [];
    let idx = 0;
    let lastFocus: HTMLElement | null = null;

    const show = (i: number) => {
      idx = (i + group.length) % group.length;
      const src = group[idx];
      // Крупный вариант, если он задан отдельно; иначе тот же файл —
      // исходники и так полноразмерные
      img.src = src.dataset.zoomSrc || src.currentSrc || src.src;
      img.alt = src.alt || '';
      counter.textContent = `${idx + 1} / ${group.length}`;
      box.classList.toggle('is-single', group.length < 2);
    };

    const open = (el: HTMLImageElement) => {
      const name = el.dataset.zoomGroup || '';
      group = Array.from(
        document.querySelectorAll<HTMLImageElement>(
          name ? `[data-zoom][data-zoom-group="${name}"]` : '[data-zoom]'
        )
      );
      lastFocus = document.activeElement as HTMLElement;
      show(group.indexOf(el));
      box.hidden = false;
      // Фон не должен прокручиваться под открытым окном
      document.body.style.overflow = 'hidden';
      box.querySelector<HTMLElement>('[data-lb-close]')?.focus();
    };

    const close = () => {
      box.hidden = true;
      document.body.style.overflow = '';
      img.src = '';
      lastFocus?.focus();
    };

    document.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement)?.closest?.('[data-zoom]');
      if (t) {
        e.preventDefault();
        // Слайдер в каталоге листается кликом по кадру — там открываем
        // только по второму клику, иначе листать станет невозможно
        open(t as HTMLImageElement);
      }
    });

    box.querySelector('[data-lb-close]')?.addEventListener('click', close);
    box.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(idx - 1));
    box.querySelector('[data-lb-next]')?.addEventListener('click', () => show(idx + 1));
    // Клик по тёмному фону закрывает, по самой картинке — нет
    box.addEventListener('click', (e) => {
      if (e.target === box) close();
    });

    document.addEventListener('keydown', (e) => {
      if (box.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(idx - 1);
      if (e.key === 'ArrowRight') show(idx + 1);
    });

    // Свайп на телефоне
    let x0 = 0;
    box.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    box.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) show(idx + (dx < 0 ? 1 : -1));
    }, { passive: true });
  }
</script>
