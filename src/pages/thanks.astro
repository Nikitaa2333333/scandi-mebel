---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Заявка отправлена — Scandi Мебель"
  description="Спасибо за заявку, мы свяжемся с вами в ближайшее время."
  noindex
>
  <main class="section theme-dark">
    <div class="container">
      <p class="tag reveal">Спасибо</p>
      <h1 data-split>Заявка отправлена</h1>
      <p class="reveal">Мы получили её и свяжемся с вами в ближайшее время.</p>
      <a class="btn" href={import.meta.env.BASE_URL}>На главную</a>
    </div>
  </main>
</Layout>
