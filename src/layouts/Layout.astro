---
import '@fontsource-variable/onest';
import '../styles/global.css';
import '../styles/blocks.css';
// Скругления — надстройка поверх системы, обязана идти последней
import '../styles/rounded.css';

interface Props {
  title: string;
  description?: string;
  /** картинка для соцсетей, относительно корня сайта */
  image?: string;
}

const { title, description = '', image = 'og.jpg' } = Astro.props;

// Астро подставит site из конфига. Без него canonical и OG будут
// относительными, а поисковики такие ссылки не склеивают.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

// Микроразметка: поисковик понимает, что это мебельная мастерская,
// а не блог. Даёт расширенный сниппет и карточку организации.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FurnitureStore',
  name: 'Scandi Мебель',
  description,
  url: canonical.href,
  image: ogImage.href,
  priceRange: '$$',
  makesOffer: [
    'Сканди', 'Шик', 'Терезза', 'Леон', 'Хермес', 'Мазерати',
    'Фоджи', 'Сканди барные', 'Майбах', 'Каспий', 'Скарлет', 'Лагуна',
  ].map((name) => ({
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Product',
      name: `${name} — стулья и столы из массива на заказ`,
      material: 'массив дерева',
      brand: { '@type': 'Brand', name: 'Scandi Мебель' },
    },
  })),
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical.href} />

    <!-- Карточка при репосте в Telegram, ВК и мессенджеры -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Scandi Мебель" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ru_RU" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#404f1d" />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🪑</text></svg>"
    />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <slot />
    <script>
      // Посимвольный ревил заголовков (реф: SplitText — символы
      // проявляются в случайном порядке, each 0.02s). Режем на спаны
      // по словам, чтобы не ломать переносы, внутри слова — по буквам.
      function splitChars(el: Element) {
        const text = el.textContent ?? '';
        el.textContent = '';
        const chars: HTMLElement[] = [];
        for (const word of text.split(/(\s+)/)) {
          if (!word) continue;
          if (/^\s+$/.test(word)) {
            el.appendChild(document.createTextNode(' '));
            continue;
          }
          const w = document.createElement('span');
          w.style.display = 'inline-block';
          for (const ch of word) {
            const s = document.createElement('span');
            s.className = 'char';
            s.textContent = ch;
            w.appendChild(s);
            chars.push(s);
          }
          el.appendChild(w);
        }
        // случайный порядок появления — как stagger from:"random" у рефа
        const order = chars.map((_, i) => i).sort(() => Math.random() - 0.5);
        order.forEach((charIdx, pos) => {
          chars[charIdx].style.setProperty('--char-delay', `${pos * 0.02}s`);
        });
      }
      document.querySelectorAll('[data-split]').forEach(splitChars);

      // Появление блоков при входе в вьюпорт (реф: farmminerals —
      // мягкий fade/rise, каскад внутри групп)
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
      );
      document
        .querySelectorAll('.reveal, .reveal-group, [data-split]')
        .forEach((el) => io.observe(el));
    </script>
    <script>
      // Русская типографика: висячие предлоги клеятся к следующему
      // слову неразрывным пробелом — глобальный проход по DOM
      import { typo } from '../lib/typo';

      function fixTypography(root: HTMLElement | null = document.body) {
        if (!root) return;
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
          acceptNode(node) {
            const tag = node.parentElement?.tagName;
            if (tag === 'SCRIPT' || tag === 'STYLE' || tag === 'TEXTAREA' || tag === 'CODE' || tag === 'PRE')
              return NodeFilter.FILTER_REJECT;
            return node.nodeValue && node.nodeValue.trim()
              ? NodeFilter.FILTER_ACCEPT
              : NodeFilter.FILTER_REJECT;
          },
        });
        const nodes: Text[] = [];
        let n: Node | null;
        while ((n = walker.nextNode())) nodes.push(n as Text);
        for (const t of nodes) {
          const fixed = typo(t.nodeValue ?? '');
          if (fixed !== t.nodeValue) t.nodeValue = fixed;
        }
      }
      fixTypography();
      document.addEventListener('astro:page-load', () => fixTypography());
    </script>
    <script>
      // Таймлайн .path__track: перетаскивание ленты мышью
      // (тачпад и тач скроллят нативно). Работает на любой странице,
      // где встретится блок — поэтому живёт в лейауте, а не в странице.
      const track = document.querySelector<HTMLElement>('.path__track');
      if (track) {
        let startX = 0;
        let startLeft = 0;
        let dragging = false;
        track.addEventListener('pointerdown', (e) => {
          dragging = true;
          startX = e.clientX;
          startLeft = track.scrollLeft;
          track.classList.add('is-drag');
          track.setPointerCapture(e.pointerId);
        });
        track.addEventListener('pointermove', (e) => {
          if (dragging) track.scrollLeft = startLeft - (e.clientX - startX);
        });
        const stopDrag = () => {
          dragging = false;
          track.classList.remove('is-drag');
        };
        track.addEventListener('pointerup', stopDrag);
        track.addEventListener('pointercancel', stopDrag);
      }
    </script>
  </body>
</html>
