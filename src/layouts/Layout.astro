---
import '@fontsource-variable/onest';
import '../styles/global.css';
import '../styles/blocks.css';
// Скругления — надстройка поверх системы, обязана идти последней
import '../styles/rounded.css';
import { asset } from '../lib/asset';

interface Props {
  title: string;
  description?: string;
  /** картинка для соцсетей, относительно корня сайта */
  image?: string;
  /** убрать страницу из поиска: служебным страницам в выдаче делать нечего */
  noindex?: boolean;
}

const { title, description = '', image = 'og.jpg', noindex = false } = Astro.props;

// Астро подставит site из конфига. Без него canonical и OG будут
// относительными, а поисковики такие ссылки не склеивают.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

// Подтверждение прав в Google Search Console. Токен приходит переменной
// сборки, а не лежит файлом в public/, как яндексовый: деплой идёт
// rsync --delete, и файл, залитый на хостинг руками, снесёт первой же
// выкладкой — вместе с ним отвалится подтверждение, а с ним и доступ к
// отправке карты сайта. Переменная переживает любую пересборку.
// Пусто — тега нет вовсе: пустой content Google считает неверным токеном.
const googleVerification = import.meta.env.GOOGLE_SITE_VERIFICATION ?? '';

// Микроразметка: поисковик понимает, что это мебельная мастерская,
// а не блог. Даёт расширенный сниппет и карточку организации.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FurnitureStore',
  name: 'Scandi Мебель',
  description,
  url: canonical.href,
  image: ogImage.href,
  priceRange: '$$',
  telephone: '+79861112230',
  // Адрес и зона обслуживания: без них поисковик не привязывает мастерскую
  // к региону и не показывает её по локальным запросам
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'RU',
    addressRegion: 'Республика Дагестан',
    addressLocality: 'Буйнакский район',
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Республика Дагестан' },
    { '@type': 'Country', name: 'Россия' },
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+79861112230',
    contactType: 'sales',
    availableLanguage: 'Russian',
  },
  // Моделей из каталога тут намеренно нет. Раньше они отдавались как
  // makesOffer с Product внутри, и Google слал по ним критическую ошибку:
  // у Product обязан быть offers, review или aggregateRating, иначе
  // страница не допускается к расширенному показу. Цен у нас нет —
  // мебель считается под размер, — а выдумывать их в разметке нельзя:
  // это и обман покупателя, и прямой путь под санкции за несовпадение
  // цены в сниппете и на сайте. Появится честная цена «от» — вернём
  // модели через AggregateOffer с lowPrice, и тогда разметка будет
  // валидной, а в сниппете появится цена.
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {googleVerification && (
      <meta name="google-site-verification" content={googleVerification} />
    )}
    <link rel="canonical" href={canonical.href} />

    <!-- Яндекс.Метрика, счётчик 111629542. Код взят из панели как есть.
         is:inline обязателен: без него Astro утащит скрипт в бандл с
         отложенной загрузкой, и счётчик перестанет ловить тех, кто
         закрыл страницу сразу. Стоит в начале head по той же причине.
         Роутер на сайте обычный, страница перезагружается — досылать
         хит на смену маршрута не нужно. -->
    <script type="text/javascript" is:inline>
      (function(m,e,t,r,i,k,a){
          m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
          m[i].l=1*new Date();
          for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
          k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
      })(window, document,'script','https://mc.yandex.ru/metrika/tag.js?id=111629542', 'ym');

      ym(111629542, 'init', {ssr:true, webvisor:true, clickmap:true, ecommerce:"dataLayer", referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});
    </script>
    <noscript><div><img src="https://mc.yandex.ru/watch/111629542" style="position:absolute; left:-9999px;" alt="" /></div></noscript>

    <!-- Карточка при репосте в Telegram, ВК и мессенджеры -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Scandi Мебель" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ru_RU" />
    <meta name="twitter:card" content="summary_large_image" />

    {/* follow оставляем и на закрытых страницах: ссылки со страницы робот
        пройдёт, саму её в индекс не возьмёт */}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="theme-color" content="#404f1d" />
    {/* Иконка отдельными файлами, а не data:-строкой: поисковики читают
        только настоящий адрес, и в выдаче Яндекса у сайта с data:-иконкой
        пустой квадрат. ico — для поиска и старых браузеров, svg — для
        современных, png — для плитки на iOS. */}
    <link rel="icon" href={asset('favicon.ico')} sizes="32x32" />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <slot />
    <script>
      // Посимвольный ревил заголовков (реф: SplitText — символы
      // проявляются в случайном порядке, each 0.02s). Режем на спаны
      // по словам, чтобы не ломать переносы, внутри слова — по буквам.
      function splitChars(el: Element) {
        const text = el.textContent ?? '';
        el.textContent = '';
        const chars: HTMLElement[] = [];
        for (const word of text.split(/(\s+)/)) {
          if (!word) continue;
          if (/^\s+$/.test(word)) {
            el.appendChild(document.createTextNode(' '));
            continue;
          }
          const w = document.createElement('span');
          w.style.display = 'inline-block';
          for (const ch of word) {
            const s = document.createElement('span');
            s.className = 'char';
            s.textContent = ch;
            w.appendChild(s);
            chars.push(s);
          }
          el.appendChild(w);
        }
        // случайный порядок появления — как stagger from:"random" у рефа
        const order = chars.map((_, i) => i).sort(() => Math.random() - 0.5);
        order.forEach((charIdx, pos) => {
          chars[charIdx].style.setProperty('--char-delay', `${pos * 0.02}s`);
        });
      }
      document.querySelectorAll('[data-split]').forEach(splitChars);

      // Появление блоков при входе в вьюпорт (реф: farmminerals —
      // мягкий fade/rise, каскад внутри групп)
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
      );
      document
        .querySelectorAll('.reveal, .reveal-group, [data-split]')
        .forEach((el) => io.observe(el));
    </script>
    <script>
      // Русская типографика: висячие предлоги клеятся к следующему
      // слову неразрывным пробелом — глобальный проход по DOM
      import { typo } from '../lib/typo';

      function fixTypography(root: HTMLElement | null = document.body) {
        if (!root) return;
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
          acceptNode(node) {
            const tag = node.parentElement?.tagName;
            if (tag === 'SCRIPT' || tag === 'STYLE' || tag === 'TEXTAREA' || tag === 'CODE' || tag === 'PRE')
              return NodeFilter.FILTER_REJECT;
            return node.nodeValue && node.nodeValue.trim()
              ? NodeFilter.FILTER_ACCEPT
              : NodeFilter.FILTER_REJECT;
          },
        });
        const nodes: Text[] = [];
        let n: Node | null;
        while ((n = walker.nextNode())) nodes.push(n as Text);
        for (const t of nodes) {
          const fixed = typo(t.nodeValue ?? '');
          if (fixed !== t.nodeValue) t.nodeValue = fixed;
        }
      }
      fixTypography();
      document.addEventListener('astro:page-load', () => fixTypography());
    </script>
    <script>
      // Таймлайн .path__track: перетаскивание ленты мышью
      // (тачпад и тач скроллят нативно). Работает на любой странице,
      // где встретится блок — поэтому живёт в лейауте, а не в странице.
      const track = document.querySelector<HTMLElement>('.path__track');
      if (track) {
        let startX = 0;
        let startLeft = 0;
        let dragging = false;
        track.addEventListener('pointerdown', (e) => {
          dragging = true;
          startX = e.clientX;
          startLeft = track.scrollLeft;
          track.classList.add('is-drag');
          track.setPointerCapture(e.pointerId);
        });
        track.addEventListener('pointermove', (e) => {
          if (dragging) track.scrollLeft = startLeft - (e.clientX - startX);
        });
        const stopDrag = () => {
          dragging = false;
          track.classList.remove('is-drag');
        };
        track.addEventListener('pointerup', stopDrag);
        track.addEventListener('pointercancel', stopDrag);
      }
    </script>
  </body>
</html>
